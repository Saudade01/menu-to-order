<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Title · menu-to-order</title>
    @if (RefreshSeconds is { } seconds)
    {
        <meta http-equiv="refresh" content="@seconds" />
    }
    <style>
        :root { --ink: #22201c; --muted: #6b645a; --paper: #faf7f1; --line: #e3ddd2; --accent: #b4532a; --ok: #2f6b3d; --warn: #fdf1e7; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--paper); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
        main { max-width: 760px; margin: 0 auto; padding: 32px 16px 64px; }
        h1 { font-size: 1.6rem; margin: 0 0 4px; }
        h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 28px 0 8px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
        .lead { color: var(--muted); margin: 0 0 24px; }
        .notice { background: var(--warn); border-left: 4px solid var(--accent); padding: 10px 14px; margin: 16px 0; }
        .ok { border-left-color: var(--ok); background: #eef6ef; }
        label { display: block; font-weight: 600; margin: 16px 0 4px; }
        input[type=text], input[type=number], input[type=file] { width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 6px; background: #fff; font: inherit; }
        button { font: inherit; padding: 9px 16px; border-radius: 6px; border: 1px solid var(--ink); background: var(--ink); color: #fff; cursor: pointer; }
        button.quiet { background: #fff; color: var(--ink); }
        button:disabled { opacity: .45; cursor: not-allowed; }
        .item { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; }
        .item small { display: block; color: var(--muted); font-weight: normal; }
        .item .dish { flex: 1; margin: 0; font-weight: normal; }
        .item .qty { width: 64px; padding: 6px; border: 1px solid var(--line); border-radius: 6px; font: inherit; text-align: center; }
        .total { border-top: 1px solid var(--line); margin-top: 8px; font-weight: 700; }
        .price { white-space: nowrap; font-variant-numeric: tabular-nums; }
        .missing { color: var(--accent); font-weight: 600; }
        .flag { background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 6px; padding: 12px; margin: 4px 0 12px; }
        .flag p { margin: 0 0 8px; }
        .reads { color: var(--muted); font-size: .9rem; }
        .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        .row input { flex: 1 1 180px; }
        .qr { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
        .qr figure { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 12px; text-align: center; break-inside: avoid; }
        .qr img { width: 100%; height: auto; image-rendering: pixelated; }
        .qr figcaption { font-weight: 600; }
        .qr code { font-size: .7rem; word-break: break-all; color: var(--muted); }
        a { color: var(--accent); }
        @@media print { .no-print { display: none; } body { background: #fff; } }
    </style>
</head>
<body>
    <main>@ChildContent</main>
</body>
</html>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int? RefreshSeconds { get; set; }
}
