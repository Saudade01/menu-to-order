<Page Title="Yeni menü">
    <h1>Menünüzün fotoğrafını sipariş sayfasına çevirin</h1>
    <p class="lead">Menü iki kez okunur. İki okumanın uyuşmadığı ya da yanlış görünen her şey, yayına çıkmadan önce size sorulur.</p>

    @if (Error is not null)
    {
        <p class="notice">@Error</p>
    }

    <form method="post" action="/restaurants" enctype="multipart/form-data">
        <AntiforgeryToken />
        <label for="name">Restoran adı</label>
        <input id="name" name="name" type="text" maxlength="80" required value="@Name" />

        <label for="tables">Masa sayısı</label>
        <input id="tables" name="tables" type="number" min="1" max="100" required value="@(Tables ?? "8")" />

        <label for="photo">Menünün fotoğrafı</label>
        <input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" capture="environment" required />

        <p class="reads">Okuma bir iki dakika sürer. Bu sırada telefonu kilitleyebilirsiniz, okuma devam eder.</p>
        <button type="submit">Menüyü oku</button>
    </form>
</Page>

@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Tables { get; set; }
}
