<Page Title="Siparişiniz">
    <h1>Siparişiniz</h1>
    <p class="lead">@Restaurant.Name · Masa @Table</p>

    @foreach (var line in Order.Lines)
    {
        <div class="item">
            <span>@line.Quantity × @line.Name</span>
            <span class="price">@Money.Lira(line.UnitPrice * line.Quantity)</span>
        </div>
    }
    <div class="item total">
        <span>Toplam</span>
        <span class="price">@Money.Lira(Order.Total)</span>
    </div>
    @if (Order.Note is not null)
    {
        <p class="reads">Not: @Order.Note</p>
    }

    <form method="post" action="/m/@Restaurant.Slug/@Table/orders" class="row">
        <AntiforgeryToken />
        <input type="hidden" name="menu" value="@Menu.Id" />
        <input type="hidden" name="note" value="@Order.Note" />
        <input type="hidden" name="key" value="@Guid.NewGuid()" />
        @foreach (var line in Order.Lines)
        {
            <input type="hidden" name="qty.@line.MenuItemId" value="@line.Quantity" />
        }
        <button type="submit">Siparişi ver</button>
        <a href="/m/@Restaurant.Slug/@Table">Sepeti düzenle</a>
    </form>
</Page>

@code {
    [Parameter, EditorRequired] public Restaurant Restaurant { get; set; } = null!;
    [Parameter, EditorRequired] public int Table { get; set; }
    [Parameter, EditorRequired] public MenuVersion Menu { get; set; } = null!;
    [Parameter, EditorRequired] public Order Order { get; set; } = null!;
}
