<Page Title="@Restaurant.Name">
    <h1>@Restaurant.Name</h1>

    @if (Published)
    {
        <p class="notice ok">This menu is live. <a href="/o/@Token/qr">Print the table QR codes</a> · <a href="/o/@Token/orders">See orders</a></p>
    }
    else
    {
        <p class="lead">The menu was read twice. Below are the fields that need your eye before it goes live.</p>
    }

    @if (Notice is not null)
    {
        <p class="notice">@Notice</p>
    }

    @if (Version.Items.Count == 0)
    {
        <div class="notice">
            <p>The menu could not be read, so nothing was saved as a dish.</p>
            @foreach (var run in Runs.Where(r => r.Error is not null))
            {
                <p class="reads">Read @run.Pass: @run.Error</p>
            }
            <p><a href="/">Try another photo</a></p>
        </div>
    }
    else
    {
        @if (!Published && LiraQuestions > 0)
        {
            <div class="notice">
                <p>@LiraQuestions price(s) on this menu have no currency printed. Are this menu's prices in lira?</p>
                <form method="post" action="/o/@Token/lira">
                    <AntiforgeryToken />
                    <button type="submit">Yes, they are in lira</button>
                </form>
            </div>
        }

        @foreach (var section in Version.Items.OrderBy(i => i.Position).GroupBy(i => i.Category ?? "Other"))
        {
            <h2>@section.Key</h2>
            @foreach (var item in section)
            {
                <div class="item">
                    <span>@item.Name @if (item.Description is not null) { <small>@item.Description</small> }</span>
                    @if (item.Price is { } price)
                    {
                        <span class="price">@Money.Lira(price)</span>
                    }
                    else
                    {
                        <span class="price missing">no price</span>
                    }
                </div>

                @if (!Published)
                {
                    @foreach (var field in Questions(item))
                    {
                        var first = field.First();
                        <div class="flag">
                            <p><strong>@field.Key</strong>: @string.Join(" · ", field.Select(f => Explain(f.Reason)))</p>
                            <p class="reads">First read: @(first.FirstPassValue ?? "nothing") · Second read: @(first.SecondPassValue ?? "nothing")</p>
                            <form method="post" action="/o/@Token/flags/@first.Id" class="row">
                                <AntiforgeryToken />
                                <input type="text" name="value" value="@Current(item, field.Key)" aria-label="Correct @field.Key.ToString().ToLowerInvariant()" />
                                <button type="submit" name="action" value="correct">Save</button>
                                @if (!(field.Key == MenuField.Price && item.Price is null))
                                {
                                    <button type="submit" class="quiet" name="action" value="confirm">Looks right</button>
                                }
                            </form>
                        </div>
                    }
                }
            }
        }

        @if (!Published)
        {
            <form method="post" action="/o/@Token/publish" class="row" style="margin-top: 32px">
                <AntiforgeryToken />
                <button type="submit" disabled="@(OpenFields > 0)">Publish the menu</button>
                @if (OpenFields > 0)
                {
                    <span class="reads">@OpenFields field(s) still need you.</span>
                }
            </form>
        }
    }
</Page>

@code {
    private static readonly CultureInfo Turkish = CultureInfo.GetCultureInfo("tr-TR");

    [Parameter, EditorRequired] public string Token { get; set; } = "";
    [Parameter, EditorRequired] public Restaurant Restaurant { get; set; } = null!;
    [Parameter, EditorRequired] public MenuVersion Version { get; set; } = null!;
    [Parameter, EditorRequired] public List<ExtractionRun> Runs { get; set; } = [];
    [Parameter] public string? Notice { get; set; }

    private bool Published => Version.Status == MenuStatus.Published;
    private IEnumerable<Flag> Open => Version.Items.SelectMany(i => i.Flags).Where(f => f.ResolvedAt is null);
    private int LiraQuestions => Open.Count(f => f.Reason == FlagReason.CurrencyMissing);
    private int OpenFields => Open.DistinctBy(f => (f.MenuItemId, f.Field)).Count();

    // Missing currency is asked once for the whole menu, so it is left out of the per-dish questions.
    private static IEnumerable<IGrouping<MenuField, Flag>> Questions(MenuItem item) =>
        item.Flags.Where(f => f.ResolvedAt is null && f.Reason != FlagReason.CurrencyMissing).GroupBy(f => f.Field);

    private static string? Current(MenuItem item, MenuField field) => field switch
    {
        MenuField.Name => item.Name,
        MenuField.Category => item.Category,
        MenuField.Description => item.Description,
        _ => item.Price?.ToString("0.##", Turkish),
    };

    private static string Explain(FlagReason reason) => reason switch
    {
        FlagReason.PassesDisagree => "the two reads disagree",
        FlagReason.PriceUnreadable => "no single price could be read",
        FlagReason.PriceOutOfRange => "the price looks implausible",
        FlagReason.ForeignCurrency => "not priced in lira",
        FlagReason.DuplicateName => "the same name appears twice in this section",
        FlagReason.UnknownCategory => "this section is not on the menu",
        FlagReason.LowLegibility => "hard to read in the photo",
        _ => "the currency is missing",
    };
}
