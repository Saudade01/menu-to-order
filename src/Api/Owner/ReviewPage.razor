<Page Title="@Restaurant.Name" RefreshSeconds="@(Reading ? 10 : null)">
    <h1>@Restaurant.Name</h1>
    @if (!Published)
    {
        <p class="reads">Bu sayfanın adresi sizin anahtarınız: yer imlerine ekleyin ve kimseyle paylaşmayın. Kaybederseniz menünüze tekrar ulaşamazsınız.</p>
    }

    @if (Notice is not null)
    {
        <p class="notice">@Notice</p>
    }

    @if (Reading)
    {
        <p class="notice">Menünüz okunuyor. Bu bir iki dakika sürer, sayfa kendini yeniler.</p>
    }
    else if (Version is null)
    {
        <div class="notice">
            <p>Okuma tamamlanamadı. Fotoğrafı yeniden okutun.</p>
            @PhotoForm
        </div>
    }
    else if (Items.Count == 0)
    {
        <div class="notice">
            @if (Unanswered.Count > 0)
            {
                <p>Menü bu sefer okunamadı, hiçbir yemek kaydedilmedi. Gemini yoğun olabilir; birkaç dakika sonra fotoğrafı yeniden okutun.</p>
                @foreach (var run in Unanswered)
                {
                    <p class="reads">@(run.Pass). okuma: @run.Error</p>
                }
            }
            else
            {
                <p>Fotoğraftaki yemekler okunamadı, hiçbir yemek kaydedilmedi. Menünün tamamı net görünecek şekilde yeniden çekip yükleyin.</p>
            }
            @PhotoForm
        </div>
    }
    else if (Published)
    {
        <p class="notice ok">Menünüz yayında. <a href="/o/@Token/qr">Masa QR kodlarını yazdırın</a> · <a href="/o/@Token/orders">Siparişleri görün</a></p>
        <details>
            <summary>Menüyü yeni fotoğrafla güncelleyin</summary>
            @PhotoForm
        </details>
    }
    else
    {
        <p class="lead">
            @Items.Count yemek okundu.
            @(Asks == 0 ? "Hepsi hazır, menüyü yayınlayabilirsiniz." : $"{Asks} konuda onayınız gerekiyor.")
        </p>

        @if (LiraQuestions > 0)
        {
            <form method="post" action="/o/@Token/lira" class="card">
                <AntiforgeryToken />
                <p class="why">@(LiraQuestions == 1 ? "Bir fiyatın" : $"{LiraQuestions} fiyatın") yanında para birimi yazmıyor. Bu menüdeki fiyatlar TL mi?</p>
                <button type="submit">Evet, fiyatlar TL</button>
            </form>
        }

        @foreach (var group in Shared)
        {
            <article class="card">
                <div class="card-head"><strong>@group.Count yemekte aynı soru</strong></div>
                <small class="reads">@string.Join(", ", group.Select(q => q.Item.Name))</small>
                @Ask(group)
            </article>
        }

        @foreach (var dish in Own)
        {
            <article class="card">
                <div class="card-head">
                    <strong>@dish.Key.Name</strong>
                    <span class="price @(dish.Key.Price is null ? "missing" : "")">@(dish.Key.Price is { } p ? Money.Lira(p) : "fiyat yok")</span>
                </div>
                @if (dish.Key.Category is not null || dish.Key.Description is not null)
                {
                    <small class="reads">@string.Join(" · ", new[] { dish.Key.Category, dish.Key.Description }.OfType<string>())</small>
                }

                @foreach (var question in dish)
                {
                    @Ask([question])
                }
            </article>
        }

        <form method="post" action="/o/@Token/publish" class="publish">
            <AntiforgeryToken />
            <button type="submit" disabled="@(OpenFields > 0)">Menüyü yayınla</button>
            @if (OpenFields > 0)
            {
                <span class="reads">Önce yukarıdaki soruları cevaplayın.</span>
            }
        </form>
    }

    @if (Items.Count > 0)
    {
        <details open="@(Published || Shared.Count + Own.Count == 0)">
            <summary>Menünün tamamı (@Items.Count yemek)</summary>
            @foreach (var section in Items.OrderBy(i => i.Position).GroupBy(i => i.Category ?? "Diğer"))
            {
                <h2>@section.Key</h2>
                @foreach (var item in section)
                {
                    <div class="item">
                        <span>@item.Name @if (item.Description is not null) { <small>@item.Description</small> }</span>
                        <span class="price @(!Published && item.Flags.Any(f => f.ResolvedAt is null && f.Field == MenuField.Price) ? "missing" : "")">@(item.Price is { } p ? Money.Lira(p) : "fiyat yok")</span>
                    </div>
                }
            }
        </details>
    }
</Page>

@code {
    private static readonly CultureInfo Turkish = CultureInfo.GetCultureInfo("tr-TR");

    [Parameter, EditorRequired] public string Token { get; set; } = "";
    [Parameter, EditorRequired] public Restaurant Restaurant { get; set; } = null!;
    [Parameter] public MenuVersion? Version { get; set; }
    [Parameter, EditorRequired] public List<ExtractionRun> Runs { get; set; } = [];
    [Parameter] public string? Notice { get; set; }
    [Parameter] public bool Reading { get; set; }

    private IReadOnlyList<MenuItem> Items => Version?.Items ?? [];
    private bool Published => Version?.Status == MenuStatus.Published;
    private IEnumerable<Flag> Open => Items.SelectMany(i => i.Flags).Where(f => f.ResolvedAt is null);
    private int LiraQuestions => Open.Count(f => f.Reason == FlagReason.CurrencyMissing);
    // The last error of each pass that never got an answer; a pass that got one on a retry is not shown.
    private List<ExtractionRun> Unanswered => Runs.GroupBy(r => r.Pass).Where(g => g.All(r => r.Error is not null))
        .Select(g => g.MaxBy(r => r.StartedAt)!).ToList();
    private int OpenFields => Open.DistinctBy(f => (f.MenuItemId, f.Field)).Count();
    private int Asks => Shared.Count + Own.Count + (LiraQuestions > 0 ? 1 : 0);

    private sealed record Question(MenuItem Item, MenuField Field, List<Flag> Flags);

    private List<Question>? _questions;
    private List<List<Question>>? _shared;
    private List<Question> AllQuestions => _questions ??= Items.OrderBy(i => i.Position)
        .SelectMany(i => Questions(i).Select(g => new Question(i, g.Key, g.ToList()))).ToList();

    // The same doubt on several dishes, such as a heading one read saw and the other did not, is asked once.
    // Prices are never answered in bulk: each one is money on its own dish.
    private List<List<Question>> Shared => _shared ??= AllQuestions.Where(q => q.Field != MenuField.Price)
        .GroupBy(q => (q.Field, q.Flags[0].FirstPassValue, q.Flags[0].SecondPassValue, string.Join(",", q.Flags.Select(f => f.Reason).Order())))
        .Where(g => g.Count() > 1).Select(g => g.ToList()).ToList();

    private List<IGrouping<MenuItem, Question>> Own => AllQuestions.Except(Shared.SelectMany(g => g)).GroupBy(q => q.Item).ToList();

    // A heading or note one read saw and the other did not gets "none" as a choice, so it is a tap rather than typing.
    private static List<string> Choices(Question q) => new[] { q.Flags[0].FirstPassValue, q.Flags[0].SecondPassValue }
        .Select(v => v ?? (q.Field is MenuField.Category or MenuField.Description ? "" : null)).OfType<string>().Distinct().ToList();

    // Missing currency is asked once for the whole menu, so it is left out of the per-dish questions.
    private static IEnumerable<IGrouping<MenuField, Flag>> Questions(MenuItem item) =>
        item.Flags.Where(f => f.ResolvedAt is null && f.Reason != FlagReason.CurrencyMissing).GroupBy(f => f.Field);

    private static string? Current(MenuItem item, MenuField field) => field switch
    {
        MenuField.Name => item.Name,
        MenuField.Category => item.Category,
        MenuField.Description => item.Description,
        _ => item.Price?.ToString("0.##", Turkish),
    };

    private RenderFragment Ask(IReadOnlyList<Question> questions) => @<div class="question">
        <p class="why"><span class="chip">@Label(questions[0].Field)</span> @string.Join(", ", questions[0].Flags.Select(f => Explain(f.Reason)))</p>

        @if (Choices(questions[0]) is { Count: 2 } choices)
        {
            <form method="post" action="/o/@Token/flags" class="row">
                <AntiforgeryToken />
                @foreach (var q in questions)
                {
                    <input type="hidden" name="ids" value="@q.Flags[0].Id" />
                }
                <input type="hidden" name="action" value="correct" />
                <span class="reads">Hangisi doğru?</span>
                @foreach (var choice in choices)
                {
                    <button type="submit" class="quiet" name="value" value="@choice">@(choice.Length == 0 ? $"{Label(questions[0].Field)} yok" : choice)</button>
                }
            </form>
        }

        <form method="post" action="/o/@Token/flags" class="row">
            <AntiforgeryToken />
            @foreach (var q in questions)
            {
                <input type="hidden" name="ids" value="@q.Flags[0].Id" />
            }
            <input type="text" name="value" value="@Current(questions[0].Item, questions[0].Field)" placeholder="@Hint(questions[0].Field)" aria-label="@Label(questions[0].Field) düzelt" />
            <button type="submit" name="action" value="correct">Kaydet</button>
            @if (!(questions[0].Field == MenuField.Price && questions[0].Item.Price is null))
            {
                <button type="submit" class="quiet" name="action" value="confirm">Doğru</button>
            }
        </form>
    </div>;

    private RenderFragment PhotoForm => @<form method="post" action="/o/@Token/photo" enctype="multipart/form-data" class="row">
        <AntiforgeryToken />
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required aria-label="Menünün fotoğrafı" />
        <button type="submit">Yeniden oku</button>
    </form>;

    private static string Hint(MenuField field) => field == MenuField.Price ? "örneğin 180 ya da 185,50" : "";

    private static string Explain(FlagReason reason) => reason switch
    {
        FlagReason.PassesDisagree => "iki okuma birbirini tutmuyor",
        FlagReason.PriceUnreadable => "tek bir fiyat okunamadı",
        FlagReason.PriceOutOfRange => "fiyat makul görünmüyor",
        FlagReason.ForeignCurrency => "fiyat TL değil",
        FlagReason.DuplicateName => "bu bölümde aynı isim iki kez geçiyor",
        FlagReason.UnknownCategory => "bu bölüm menüde yok",
        FlagReason.LowLegibility => "fotoğrafta zor okunuyor",
        _ => "para birimi yazmıyor",
    };

    private static string Label(MenuField field) => field switch
    {
        MenuField.Name => "Ad",
        MenuField.Category => "Bölüm",
        MenuField.Description => "Açıklama",
        _ => "Fiyat",
    };
}
