<Page Title="Orders" RefreshSeconds="20">
    <h1>@Restaurant.Name · orders</h1>
    <p class="lead">Newest first. This page refreshes itself every 20 seconds.</p>
    <p><a href="/o/@Token/review">Menu</a> · <a href="/o/@Token/qr">QR codes</a></p>

    @if (Orders.Count == 0)
    {
        <p class="reads">No orders yet.</p>
    }

    @foreach (var order in Orders)
    {
        <div class="flag order">
            <p><strong>Table @order.TableNumber</strong> <span class="reads">· @Local(order.CreatedAt)</span></p>
            @foreach (var line in order.Lines)
            {
                <div class="item"><span>@line.Quantity × @line.Name</span><span class="price">@Money.Lira(line.UnitPrice * line.Quantity)</span></div>
            }
            @if (order.Note is not null)
            {
                <p class="reads">Note: @order.Note</p>
            }
            <div class="item total"><span>Total</span><span class="price">@Money.Lira(order.Total)</span></div>
        </div>
    }
</Page>

@code {
    private static readonly TimeZoneInfo Istanbul = TimeZoneInfo.FindSystemTimeZoneById("Europe/Istanbul");

    [Parameter, EditorRequired] public string Token { get; set; } = "";
    [Parameter, EditorRequired] public Restaurant Restaurant { get; set; } = null!;
    [Parameter, EditorRequired] public List<Order> Orders { get; set; } = [];

    private static string Local(DateTimeOffset at) => TimeZoneInfo.ConvertTime(at, Istanbul).ToString("dd.MM HH:mm", CultureInfo.InvariantCulture);
}
