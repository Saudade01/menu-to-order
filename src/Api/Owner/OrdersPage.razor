<Page Title="Siparişler" RefreshSeconds="20">
    <h1>@Restaurant.Name · siparişler</h1>
    <p class="lead">Bugünün siparişleri, en yenisi en üstte. Sayfa 20 saniyede bir kendini yeniler.</p>
    <p><a href="/o/@Token/review">Menü</a> · <a href="/o/@Token/qr">QR kodları</a></p>

    @if (Orders.Count == 0)
    {
        <p class="reads">Bugün henüz sipariş yok.</p>
    }

    @foreach (var order in Orders)
    {
        <div class="card">
            <p><strong>Masa @order.TableNumber</strong> <span class="reads">· @Local(order.CreatedAt)</span></p>
            @foreach (var line in order.Lines)
            {
                <div class="item"><span>@line.Quantity × @line.Name</span><span class="price">@Money.Lira(line.UnitPrice * line.Quantity)</span></div>
            }
            @if (order.Note is not null)
            {
                <p class="reads">Not: @order.Note</p>
            }
            <div class="item total"><span>Toplam</span><span class="price">@Money.Lira(order.Total)</span></div>
        </div>
    }
</Page>

@code {
    public static readonly TimeZoneInfo Istanbul = TimeZoneInfo.FindSystemTimeZoneById("Europe/Istanbul");

    [Parameter, EditorRequired] public string Token { get; set; } = "";
    [Parameter, EditorRequired] public Restaurant Restaurant { get; set; } = null!;
    [Parameter, EditorRequired] public List<Order> Orders { get; set; } = [];

    private static string Local(DateTimeOffset at) => TimeZoneInfo.ConvertTime(at, Istanbul).ToString("dd.MM HH:mm", CultureInfo.InvariantCulture);
}
